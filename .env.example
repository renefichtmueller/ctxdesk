# CtxDesk — Environment Configuration
# Copy this to .env and fill in your values.
# .env is gitignored — never commit secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default — no setup needed)
DATABASE_URL="file:./dev.db"

# ─── Application ─────────────────────────────────────────────────────────────
# The URL where CtxDesk is accessible (used in UI & generated queue files)
# Default: http://localhost:3002
NEXT_PUBLIC_APP_URL="http://localhost:3002"

# Optional: bind to all interfaces (needed for LAN access)
HOSTNAME="0.0.0.0"
PORT=3002

# ─── AI / Ollama ─────────────────────────────────────────────────────────────
# URL of your Ollama instance (or LM Studio)
OLLAMA_URL="http://localhost:11434"

# Optional: API key if your Ollama is behind an nginx proxy with key auth
# OLLAMA_API_KEY=""

# ─── Sync Scripts (for multi-machine setups) ─────────────────────────────────
# Used by scripts/sync-db.sh and scripts/sync-md.sh
# MACSTUDIO_IP="192.168.x.x"   # LAN IP of primary machine (Mac Studio)
# MACSTUDIO_USER="yourusername"
# MACBOOK_IP_LAN="192.168.x.x" # LAN IP of secondary machine (MacBook)
# MACBOOK_IP_VPN="10.x.x.x"    # VPN IP of secondary machine (optional)
# SYNC_USER="yourusername"

# ─── Deploy Button ───────────────────────────────────────────────────────────
# Shell command to run when the Deploy button is clicked on an "in_review" ticket
# Example: deploy to Cloudflare Pages
# DEPLOY_COMMAND='cd /path/to/your/site && npx wrangler pages deploy . --project-name my-project 2>&1'
# Example: custom webhook
# DEPLOY_COMMAND='curl -X POST https://your-ci.example.com/deploy'

# ─── Claude Context Page ──────────────────────────────────────────────────────
# Path to your Claude global MEMORY.md (shown in Context editor)
# Find yours: ls ~/.claude/projects/*/memory/MEMORY.md
# CLAUDE_MEMORY_PATH="/Users/you/.claude/projects/-Users-you-Desktop-...-Code/memory/MEMORY.md"

# ─── Agenda Sync ─────────────────────────────────────────────────────────────
# Optional: direct path to agenda.md (for /api/agenda-sync)
# AGENDA_MD_PATH="/path/to/agenda.md"
# Hash of your Claude project directory (used to auto-locate project files)
# CLAUDE_PROJECT_HASH="-Users-you-Desktop-Claude-Code"
